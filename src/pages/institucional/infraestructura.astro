---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Infraestructura y Equipamiento">

  <main>

    <!-- Banda de título -->
    <section class="banda">
      <div class="contenedor">
        <p class="etiqueta">Institucional</p>
        <h1>Infraestructura y Equipamiento</h1>
      </div>
    </section>

    <!-- Infraestructura y equipamiento -->
    <section class="seccion">
      <div class="contenedor">

        <p class="bajada">
          Permite concretar uno de los principales objetivos:
          formación práctica de sus alumnos.
        </p>

        <div class="grilla grilla--4" style="margin-top: 40px;">

          <!-- Máquinas y Herramientas -->
          <article class="tarjeta">
            <figure class="foto">
              <img
                src="/imagenes/institucional/infraestructura/maquinas-herramientas.jpg"
                alt="Sector de Máquinas y Herramientas"
              />
            </figure>

            <h2 class="h3 titulo-tarjeta">
              Máquinas y Herramientas
            </h2>

            <ul>
              <li>Sector de Máquinas y Herramientas</li>
              <li>Sector de Soldadura</li>
              <li>Laboratorio de CNC</li>
              <li>Laboratorio de Metrología Dimensional</li>
            </ul>
          </article>

          <!-- Química -->
          <article class="tarjeta">
            <figure class="foto">
              <img
                src="/imagenes/institucional/infraestructura/quimica.jpg"
                alt="Laboratorio de Química"
              />
            </figure>

            <h2 class="h3 titulo-tarjeta">
              Química
            </h2>

            <ul>
              <li>Laboratorio Química</li>
              <li>Planta Piloto de Biodiesel</li>
            </ul>
          </article>

          <!-- Diseño Asistido por Computadora -->
          <article class="tarjeta">
            <figure class="foto">
              <img
                src="/imagenes/institucional/infraestructura/diseno-asistido.jpg"
                alt="Laboratorio de Diseño Asistido por Computadora"
              />
            </figure>

            <h2 class="h3 titulo-tarjeta">
              Diseño Asistido por Computadora
            </h2>

            <ul>
              <li>Laboratorio de Diseño Asistido por Computadora</li>
              <li>Laboratorio de Informática de Gestión</li>
            </ul>
          </article>

          <!-- Neumática e Hidráulica -->
          <article class="tarjeta">
            <figure class="foto">
              <img
                src="/imagenes/institucional/infraestructura/neumatica-hidraulica.jpg"
                alt="Laboratorio de Neumática e Hidráulica"
              />
            </figure>

            <h2 class="h3 titulo-tarjeta">
              Neumática e Hidráulica
            </h2>

            <ul>
              <li>Laboratorio de Neumática e Hidráulica</li>
              <li>Laboratorio de Electricidad y Electrónica</li>
              <li>Laboratorio Física</li>
            </ul>
          </article>

        </div>

      </div>
    </section>

  </main>

</Layout>