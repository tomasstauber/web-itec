---
import Layout from '../../../layouts/Layout.astro';
import DATOS from '../../../data/datos.json';

export function getStaticPaths() {
  return DATOS.noticias.map((noticia) => ({
    params: {
      slug: noticia.slug
    },
    props: {
      noticia
    }
  }));
}

const { noticia } = Astro.props;
---

<Layout title={noticia.titulo}>

  <main>

    <!-- Banda de título -->
    <section class="banda">
      <div class="contenedor">
        <p class="etiqueta">Noticias</p>
        <h1>{noticia.titulo}</h1>
      </div>
    </section>

    <!-- Artículo -->
    <section class="seccion">
      <div class="contenedor">

        <p class="etiqueta">
          {noticia.fecha}
        </p>

        <p class="bajada">
          {noticia.categorias}
        </p>

        <div class="contenido-noticia">

          {noticia.cuerpo.map((parrafo) => (
            <p>{parrafo}</p>
          ))}

        </div>

        <a
          href="/institucional/noticias"
          class="btn btn--secundario"
        >
          ← Volver a Noticias
        </a>

      </div>
    </section>

  </main>

</Layout>

<style>
  .contenido-noticia {
    margin: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contenido-noticia p {
    line-height: 1.8;
  }
</style>