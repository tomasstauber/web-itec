---
import Layout from '../../layouts/Layout.astro';
import DATOS from '../../data/datos.json';
---

<Layout title="Autoridades">

  <main>

    <!-- Banda de título -->
    <section class="banda">
      <div class="contenedor">
        <p class="etiqueta">Institucional</p>
        <h1>Autoridades</h1>
      </div>
    </section>

    <!-- Listado de autoridades -->
    <section class="seccion">
      <div class="contenedor">

        <div class="grilla grilla--3">

          {
            DATOS.autoridades.map((autoridad) => (
              <article class="tarjeta">

                <h2 class="titulo-tarjeta">
                  {autoridad.cargo}
                </h2>

                <p>
                  <strong>{autoridad.nombre}</strong>
                </p>

                <p class="bajada">
                  {autoridad.entidad}
                </p>

              </article>
            ))
          }

        </div>

      </div>
    </section>

  </main>

</Layout>