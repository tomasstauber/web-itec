---
import Layout from '../../layouts/Layout.astro';

import inet from '../../assets/articulacion/inet.png';
import trabajoNacion from '../../assets/articulacion/trabajo-nacion.png';
import cienciaNacion from '../../assets/articulacion/ciencia-nacion.png';
import produccionNacion from '../../assets/articulacion/produccion-nacion.png';
import redAcet from '../../assets/articulacion/red-acet.png';
import redAdimra from '../../assets/articulacion/red-adimra.png';

import energiaSantaFe from '../../assets/articulacion/energia-santafe.png';
import cienciaSantaFe from '../../assets/articulacion/ciencia-santafe.png';
import produccionSantaFe from '../../assets/articulacion/produccion-santafe.png';
import educacionSantaFe from '../../assets/articulacion/educacion-santafe.png';

import acader from '../../assets/articulacion/acader.png';
import cimae from '../../assets/articulacion/cimae.png';
import camaraMetalurgica from '../../assets/articulacion/camara-metalurgica.png';
import icdera from '../../assets/articulacion/icdera.png';
import poloTecnologico from '../../assets/articulacion/polo-tecnologico.png';
---

<Layout title="Articulación">

  <main>

    <!-- Banda de título -->
    <section class="banda">
      <div class="contenedor">
        <p class="etiqueta">Institucional</p>
        <h1>Articulación</h1>
      </div>
    </section>

    <!-- Introducción -->
    <section class="seccion">
      <div class="contenedor">
        <p class="bajada">
          El ITEC El Molino articula con diferentes organismos e instituciones
          a nivel nacional, provincial y regional.
        </p>
      </div>
    </section>

    <!-- Nivel nacional -->
    <section class="seccion">
      <div class="contenedor">

        <p class="etiqueta">A nivel nacional</p>

        <div class="fila-logos fila-logos--nacional">

          <div class="chip-logo">
            <img src={inet.src} alt="INET" />
          </div>

          <div class="chip-logo">
            <img
              src={trabajoNacion.src}
              alt="Ministerio de Trabajo, Empleo y Seguridad Social"
            />
          </div>

          <div class="chip-logo">
            <img
              src={cienciaNacion.src}
              alt="Ministerio de Ciencia, Tecnología e Innovación Productiva"
            />
          </div>

          <div class="chip-logo">
            <img
              src={produccionNacion.src}
              alt="Ministerio de Producción"
            />
          </div>

          <div class="chip-logo">
            <img
              src={redAcet.src}
              alt="Red ACET"
            />
          </div>

          <div class="chip-logo">
            <img
              src={redAdimra.src}
              alt="Red de Centros Tecnológicos ADIMRA"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Nivel provincial -->
    <section class="seccion seccion--gris">
      <div class="contenedor">

        <p class="etiqueta">A nivel provincial</p>

        <div class="fila-logos fila-logos--provincial">

          <div class="chip-logo">
            <img
              src={energiaSantaFe.src}
              alt="Secretaría de Estado de la Energía de Santa Fe"
            />
          </div>

          <div class="chip-logo">
            <img
              src={cienciaSantaFe.src}
              alt="Ministerio de Ciencia, Tecnología e Innovación de Santa Fe"
            />
          </div>

          <div class="chip-logo">
            <img
              src={produccionSantaFe.src}
              alt="Ministerio de la Producción de Santa Fe"
            />
          </div>

          <div class="chip-logo">
            <img
              src={educacionSantaFe.src}
              alt="Ministerio de Educación de Santa Fe"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Nivel regional -->
    <section class="seccion">
      <div class="contenedor">

        <p class="etiqueta">A nivel regional</p>

        <div class="fila-logos fila-logos--regional">

          <div class="chip-logo">
            <img
              src={acader.src}
              alt="ACADER"
            />
          </div>

          <div class="chip-logo">
            <img
              src={cimae.src}
              alt="CIMAE"
            />
          </div>

          <div class="chip-logo">
            <img
              src={camaraMetalurgica.src}
              alt="Cámara de Industria Metalúrgica y Afines"
            />
          </div>

          <div class="chip-logo">
            <img
              src={icdera.src}
              alt="ICDeRA"
            />
          </div>

          <div class="chip-logo">
            <img
              src={poloTecnologico.src}
              alt="Polo Tecnológico Esperanza"
            />
          </div>

        </div>
      </div>
    </section>

  </main>

</Layout>

<style>

  /* Contenedor general de logos */
  .fila-logos {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 1.5rem;
  }

  /* Nacional: 6 logos distribuidos 3 x 2 */
  .fila-logos--nacional {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Provincial: 4 logos en una fila */
  .fila-logos--provincial {
    grid-template-columns: repeat(4, 1fr);
  }

  /* Regional: 5 logos en una fila */
  .fila-logos--regional {
    grid-template-columns: repeat(5, 1fr);
  }

  /* Tarjeta de cada institución */
  .chip-logo {
    min-height: 110px;
    padding: 1rem;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: #fff;

    border: 1px solid #ddd;
    border-radius: 12px;
  }

  /* Logos */
  .chip-logo img {
    display: block;

    max-width: 100%;
    max-height: 75px;

    width: auto;
    height: auto;

    object-fit: contain;
  }

  /* Fondo alternado */
  .seccion--gris {
    background-color: #f3f3f3;
  }

  /* Adaptación para pantallas pequeñas */
  @media (max-width: 768px) {

    .fila-logos--nacional,
    .fila-logos--provincial,
    .fila-logos--regional {
      grid-template-columns: repeat(2, 1fr);
    }

    .chip-logo {
      min-height: 90px;
    }

    .chip-logo img {
      max-height: 60px;
    }
  }

</style>