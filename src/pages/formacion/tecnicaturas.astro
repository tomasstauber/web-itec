---
import Layout from '../../layouts/Layout.astro';
import Carrera from '../../components/Carrera.astro';
import DATOS from '../../data/datos.json';
---

<Layout title="Tecnicaturas">

  <main>

    <!-- Banda de título -->
    <section class="banda" style="--acento:var(--tec)">
      <div class="contenedor">
        <p class="etiqueta">Formación</p>
        <h1>Tecnicaturas Terciarias</h1>
      </div>
    </section>

    <!-- Listado de carreras -->
    <section class="seccion">
      <div class="contenedor">

        <div class="grilla">

          {
            DATOS.carreras.map((carrera) => (
              <Carrera carrera={carrera} />
            ))
          }

        </div>

      </div>
    </section>

  </main>

</Layout>