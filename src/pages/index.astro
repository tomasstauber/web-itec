---
import Layout from '../layouts/Layout.astro';

/* Entidades fundadoras (bloque "El Molino"). Van como chips de texto,
   igual que en el prototipo: todavía no hay imágenes de esos logos. */
const fundadoras = [
  'CICAE',
  'Municipalidad de Esperanza',
  'Sociedad Rural de las Colonias',
];

/* Tarjetas de acceso rápido */
const accesos = [
  {
    icono: '🎓',
    titulo: 'FORMACIÓN',
    texto: 'Espacios propicios para el logro de aprendizaje significativos de los distintos niveles organizacionales.',
    href: '/formacion',
  },
  {
    icono: '⚙️',
    titulo: 'SERVICIOS',
    texto: 'Servicios tecnológicos, de asistencia técnica y gestión de financiamiento.',
    href: '/servicios',
  },
];

/* Galería "Así aprendemos en el ITEC".
   Las fotos están en public/img/home/. `alt` describe lo que se ve,
   para quien no puede ver la imagen. */
const galeria = [
  {
    leyenda: 'Equipamiento tecnológico',
    foto: '/img/home/equipamiento-tecnologico.jpg',
    alt: 'Estudiantes con mochilas entrando al edificio del Instituto Tecnológico El Molino',
  },
  {
    leyenda: 'Aula taller',
    foto: '/img/home/aula-taller.jpg',
    alt: 'Dos personas con máscaras de soldar trabajando sobre una mesa de soldadura',
  },
  {
    leyenda: 'Formación por competencias',
    foto: '/img/home/formacion-por-competencias.jpg',
    alt: 'Grupo de personas sentadas en mesas redondas durante una capacitación',
  },
];

/* Franja de credenciales / instituciones asociadas */
const credenciales = [
  'RED de Centros Tecnológicos ADIMRA',
  'Ministerio de Trabajo',
  'CSI',
  'CTDA',
  'IAEA',
  'CAMSFE',
  'CEFOSE',
];
---

<Layout title="Inicio">

  <main>

    <!-- 1. Hero -->
    <section class="hero">
      <div class="contenedor">
        <p class="etiqueta">Instituto Tecnológico El Molino · 25º Aniversario · Esperanza, Santa Fe</p>
        <h1>«Formando personas valiosas para la región y sus empresas»</h1>
        <p class="bajada">
          Educación técnica y servicios tecnológicos para el sector productivo,
          desde hace 25 años.
        </p>
        <a class="btn btn--primario" href="/formacion">Conocé la oferta 2026</a>
      </div>
    </section>

    <!-- 2. Bloque El Molino + entidades fundadoras -->
    <section class="seccion">
      <div class="contenedor">

        <div class="grilla grilla--2 revelar molino">

          <div>
            <p class="etiqueta molino__etiqueta">El Molino</p>
            <h2 class="molino__titulo">Es un proyecto educativo de articulación público-privada</h2>
            <p class="bajada molino__bajada">
              que surge y se sostiene para dar respuesta a necesidades de
              formación práctica y brindar servicios para la mejora de la
              competitividad de las pymes de la región.
            </p>
            <a class="btn btn--secundario" href="/institucional/mision">+ Acerca del instituto</a>
          </div>

          <div>
            <p class="etiqueta fundadoras__etiqueta">Entidades fundadoras</p>
            <div class="logos fundadoras__logos">
              {fundadoras.map((entidad) => <span class="chip-logo">{entidad}</span>)}
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. Accesos rápidos: Formación / Servicios -->
    <section class="seccion seccion--gris">
      <div class="contenedor">

        <div class="grilla grilla--2 revelar">

          {
            accesos.map((acceso) => (
              <article class="tarjeta">
                <div class="tarjeta__icono" aria-hidden="true">{acceso.icono}</div>
                <h2 class="h3">{acceso.titulo}</h2>
                <p class="bajada">{acceso.texto}</p>
                <a class="btn btn--primario" href={acceso.href}>
                  Nuestra propuesta
                  <span class="solo-lectores"> de {acceso.titulo.toLowerCase()}</span>
                </a>
              </article>
            ))
          }

        </div>

      </div>
    </section>

    <!-- 4. Galería -->
    <section class="seccion">
      <div class="contenedor">

        <h2 class="centrado revelar galeria__titulo">Así aprendemos en el ITEC</h2>

        <div class="grilla grilla--3 revelar">
          {
            galeria.map((item) => (
              <figure class="foto">
                <img src={item.foto} alt={item.alt} loading="lazy" />
                <figcaption>{item.leyenda}</figcaption>
              </figure>
            ))
          }
        </div>

      </div>
    </section>

    <!-- 5. Banda oscura: Empresas que Educan -->
    <section class="seccion empresas">
      <div class="contenedor centrado revelar">
        <p class="etiqueta empresas__etiqueta">Programa Empresas que Educan</p>
        <h2 class="empresas__titulo">
          Potenciar la vinculación del ITEC con las empresas de la ciudad y
          fidelizar su relación a través de la generación de espacios de
          intercambio y formación
        </h2>
        <a class="btn btn--claro" href="/empresas">Conocé el programa</a>
      </div>
    </section>

    <!-- 6. Franja de credenciales (RED ADIMRA) -->
    <section class="seccion seccion--gris">
      <div class="contenedor centrado revelar">
        <p class="bajada credenciales__texto">
          <strong>La RED de Centros Tecnológicos de ADIMRA</strong> se posiciona
          como una red federal de tecnología y formación de calidad, a
          disposición de las empresas y trabajadores metalúrgicos de todo el
          país.
        </p>
        <div class="logos">
          {credenciales.map((institucion) => <span class="chip-logo">{institucion}</span>)}
        </div>
      </div>
    </section>

  </main>

</Layout>

<style>
  /* ---------- 1. Hero ---------- */

  /* Fondo: la foto del edificio (public/img/home/header.jpg) con un velo
     oscuro encima para que el texto blanco se lea bien. El color sólido
     del final se ve mientras la foto carga. */
  .hero {
    position: relative;
    color: #fff;
    background:
      linear-gradient(rgba(38, 20, 22, .72), rgba(38, 20, 22, .72)),
      url('/img/home/header.jpg') center / cover no-repeat,
      #3d282b;
    padding: 112px 0 120px;
    text-align: center;
  }

  .hero .etiqueta {
    color: #f3c9cc;
  }

  .hero h1 {
    margin: 16px auto 12px;
    max-width: 820px;
  }

  .hero .bajada {
    color: rgba(255, 255, 255, .85);
    max-width: 620px;
    margin: 0 auto 32px;
  }

  /* ---------- 2. Bloque El Molino ---------- */
  .molino {
    align-items: center;
  }

  .molino__etiqueta {
    color: var(--rojo);
  }

  .molino__titulo {
    margin: 12px 0 16px;
  }

  .molino__bajada {
    margin-bottom: 24px;
  }

  .fundadoras__etiqueta {
    color: var(--gris-600);
    margin-bottom: 16px;
  }

  .fundadoras__logos {
    justify-content: flex-start;
  }

  /* ---------- 3. Accesos rápidos ---------- */
  .tarjeta__icono {
    background: rgba(176, 30, 40, .08);
  }

  /* Texto disponible para lectores de pantalla pero oculto a la vista:
     distingue los dos botones "Nuestra propuesta" */
  .solo-lectores {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- 4. Galería ---------- */
  .galeria__titulo {
    margin-bottom: 40px;
  }

  /* ---------- 5. Banda Empresas que Educan ---------- */
  .empresas {
    background: var(--gris-900);
    color: #fff;
  }

  .empresas__etiqueta {
    color: var(--cap);
  }

  .empresas__titulo {
    max-width: 840px;
    margin: 16px auto 28px;
    color: #fff;
  }

  /* ---------- 6. Credenciales ---------- */
  .credenciales__texto {
    max-width: 720px;
    margin: 0 auto 32px;
  }

  .credenciales__texto strong {
    color: var(--gris-900);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 560px) {
    .hero {
      padding: 72px 0 80px;
    }
  }
</style>
